{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "share",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",

  // Reachable at https://img.<account-subdomain>.workers.dev
  "workers_dev": true,
  "preview_urls": false,

  "r2_buckets": [
    { "binding": "BLOBS", "bucket_name": "img-photos" }
  ],

  "images": { "binding": "IMAGES" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "img",
      // Replace with the id printed by: npx wrangler d1 create img
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],

  "triggers": {
    "crons": ["*/10 * * * *"]
  },

  "ratelimits": [
    // Burst control. Limits apply per Cloudflare location and are approximate.
    { "name": "READ_PER_IP", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
    { "name": "READ_GLOBAL", "namespace_id": "1002", "simple": { "limit": 3000, "period": 60 } }
  ],

  "vars": {
    "DEFAULT_TTL_SECONDS": "86400",
    "SHARE_REQUEST_PRESETS": "[{\"label\":\"50 requests\",\"requests\":50},{\"label\":\"100 requests\",\"requests\":100},{\"label\":\"250 requests\",\"requests\":250},{\"label\":\"500 requests\",\"requests\":500},{\"label\":\"1,000 requests\",\"requests\":1000},{\"label\":\"2,500 requests\",\"requests\":2500},{\"label\":\"5,000 requests\",\"requests\":5000},{\"label\":\"10,000 requests\",\"requests\":10000}]",
    "DEFAULT_SHARE_REQUESTS": "1000",
    "TTL_PRESETS": "[{\"label\":\"1 hour\",\"seconds\":3600},{\"label\":\"6 hours\",\"seconds\":21600},{\"label\":\"24 hours\",\"seconds\":86400},{\"label\":\"3 days\",\"seconds\":259200},{\"label\":\"7 days\",\"seconds\":604800},{\"label\":\"14 days\",\"seconds\":1209600},{\"label\":\"30 days\",\"seconds\":2592000},{\"label\":\"90 days\",\"seconds\":7776000},{\"label\":\"365 days\",\"seconds\":31536000}]",
    "MAX_UPLOAD_BYTES": "20971520",
    "MAX_IMAGES": "20",
    "MAX_TOTAL_BYTES": "52428800",
    "SITE_NAME": "share"
  },

  "observability": { "enabled": true }
}
